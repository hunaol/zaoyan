# 复制为 deploy/.env；真实部署时全部替换为强密码。不要提交 .env。
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-different-strong-root-password
# Navicat 等本机客户端使用此端口；容器之间仍使用 mysql:3306。
MYSQL_PORT=3307
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-strong-admin-password
OPERATOR_PASSWORD=replace-with-strong-operator-password
WEB_PORT=8088
WEB_BIND=127.0.0.1
# Docker Hub 下载超时时使用镜像源；网络可直连时可设为 docker.io/library/
IMAGE_PREFIX=docker.m.daocloud.io/library/
# 容器内可见的绝对路径。模型文件放在 deploy/models/ 后填 /app/models/best.pt
YOLO_WEIGHTS=
